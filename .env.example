# Public canonical origin used in canonical tags, sitemap.xml, robots.txt, and JSON-LD
VITE_SITE_URL="https://cliplab1.ai.studio"

# Optional external CORS-enabled origin for ffmpeg-core.js + ffmpeg-core.wasm (defaults to /ffmpeg)
VITE_FFMPEG_CORE_BASE_URL="/ffmpeg"

# AI crawler allowance in robots.txt ("true" by default; set "false" to disallow AI bots)
VITE_ALLOW_AI_CRAWLERS="true"

# Optional Webmaster & Search Console verification IDs (leave blank unless configured)
VITE_GSC_VERIFICATION=""
VITE_BING_VERIFICATION=""
VITE_INDEXNOW_KEY=""

# Optional monetization flags (ads remain disabled unless VITE_ADS_ENABLED="true")
VITE_ADS_ENABLED="false"
VITE_AD_NETWORK="placeholder"
VITE_AD_PUBLISHER_ID=""
VITE_AD_SLOT_SIDEBAR=""
VITE_AD_SLOT_BELOW_EDITOR=""
VITE_AD_SLOT_FOOTER=""
